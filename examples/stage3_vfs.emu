# Этап 3: все команды этапов 1-3 (запускать с любым ZIP)
# имя VFS видно в приглашении
ls
ls -l /tmp
cd docs
# переменные окружения и кавычки
ls $HOME
ls "my dir" $USER
# ошибки разбора и аргументов
foo bar
cd a b
ls "oops
exit 1
# vfs-init: ошибка, затем успех (ZIP на диске очищается)
vfs-init x
vfs-init
ls
exit
